{
  "name": "magelens",
  "version": "1.9.0",
  "private": true,
  "license": "Elastic-2.0",
  "description": "Quickly bootstrap Magento with PHP, JavaScript, and HTML template code coverage",
  "scripts": {
    "check:static": "node tests/ci/static.cjs",
    "coverage": "./bin/run-coverage",
    "cy:coverage": "./bin/run-coverage",
    "test:integration": "node --test --test-concurrency=2 tests/*.test.cjs",
    "test:e2e": "bash tests/e2e-isolated.sh",
    "test:e2e:matrix": "bash tests/e2e-matrix.sh",
    "test:branching-dashboard": "node tests/branching-dashboard-browser.cjs"
  },
  "devDependencies": {
    "@cypress/code-coverage": "4.1.3",
    "@eslint/js": "10.0.1",
    "@vitaliiboiko/magento-template-coverage": "1.5.4",
    "cypress": "16.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "nyc": "18.0.0"
  },
  "nyc": {
    "include": [
      "src/app/code/**/*.js",
      "src/app/design/frontend/**/*.js",
      "src/app/design/adminhtml/**/*.js"
    ],
    "exclude": [
      "**/*.cy.js",
      "**/Test/**",
      "**/Setup/**",
      "**/cypress/**"
    ],
    "report-dir": "coverage/js",
    "reporter": [
      "html",
      "json",
      "json-summary",
      "text-summary"
    ],
    "instrument": false,
    "sourceMap": false
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
