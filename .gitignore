/.runtime/
# Track only application sources inside the otherwise generated Magento tree.
/src/*
!/src/app/
/src/app/*
!/src/app/code/
!/src/app/design/
/src/app/design/*
!/src/app/design/frontend/
!/src/app/design/adminhtml/
/lib/
/env/
/compose.versions.yaml
# Upstream tools are installed locally; keep only our integration scripts tracked.
/bin/*
!/bin/build-php-image
!/bin/application-compose
!/bin/application-domain
!/bin/badges.cjs
!/bin/browser-navigation.cjs
!/bin/common
!/bin/compose-project
!/bin/dependencies
!/bin/expose-tools
!/bin/finalize.cjs
!/bin/install
!/bin/prepare.cjs
!/bin/project.cjs
!/bin/javascript-scope.cjs
!/bin/report-browser.cjs
!/bin/report-index.cjs
!/bin/run-browser.cjs
!/bin/run-playwright.cjs
!/bin/run-coverage
!/bin/runner
!/bin/sync-dependencies.cjs
/.env
/rootCA.pem
/policies.json
/node_modules/
/.nyc_output/
/coverage/*
!/coverage/badges/
/cypress/screenshots/
/cypress/videos/
/.idea/
*.log
