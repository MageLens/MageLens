/** @var \Magento\Framework\View\Element\Template $block */
$value = $block->getData('value');
$nested = $block->getData('nested');
?>
<span data-layout-dynamic><?= $block->escapeHtml($value) ?></span>
<span data-layout-dynamic-nested><?= $block->escapeHtml(is_array($nested) ? implode('|', $nested) : $nested) ?></span>
