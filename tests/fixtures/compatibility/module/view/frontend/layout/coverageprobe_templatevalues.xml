        </block>
        <block class="Magento\Framework\View\Element\Template" name="magelens.template.values.equal.argument" template="MageLens_Compatibility::layout-template-value.phtml">
            <arguments><argument name="template" xsi:type="string">MageLens_Compatibility::layout-template-value.phtml</argument></arguments>
        </block>
        <block class="Magento\Framework\View\Element\Template" name="magelens.template.values.late.argument">
            <arguments><argument name="template" xsi:type="string">MageLens_Compatibility::layout-template-value.phtml</argument></arguments>
