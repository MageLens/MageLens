<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <block class="Magento\Framework\View\Element\Template" name="magelens.layout.dynamic.nested" template="MageLens_Compatibility::layout-dynamic.phtml">
        <arguments>
            <argument name="value" xsi:type="string">xml-value</argument>
            <argument name="nested" xsi:type="array">
                <item name="changed" xsi:type="string">xml-value</item>
                <item name="surviving" xsi:type="string">xml-value</item>
            </argument>
        </arguments>
    </block>
</layout>
