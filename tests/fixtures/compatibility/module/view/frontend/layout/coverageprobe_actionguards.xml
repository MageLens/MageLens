<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <container name="magelens.action.guard.root" output="1">
        <block class="MageLens\Compatibility\Block\LayoutActionGuard" name="magelens.action.guard.allowed">
            <action method="mark" ifconfig="magelens_layout_fixture/actions/allowed"><argument name="marker" xsi:type="string">allowed</argument></action>
        </block>
        <block class="MageLens\Compatibility\Block\LayoutActionGuard" name="magelens.action.guard.denied">
            <action method="mark" ifconfig="magelens_layout_fixture/actions/denied"><argument name="marker" xsi:type="string">denied</argument></action>
        </block>
        <block class="MageLens\Compatibility\Block\LayoutActionGuard" name="magelens.action.guard.duplicate">
            <action method="mark" ifconfig="magelens_layout_fixture/actions/duplicate"><argument name="marker" xsi:type="string">first</argument></action>
            <action method="mark" ifconfig="magelens_layout_fixture/actions/duplicate"><argument name="marker" xsi:type="string">second</argument></action>
        </block>
        <block class="MageLens\Compatibility\Block\LayoutActionGuard" name="magelens.action.guard.empty">
            <action method="mark" ifconfig=""><argument name="marker" xsi:type="string">empty</argument></action>
        </block>
        <block class="MageLens\Compatibility\Block\LayoutActionGuard" name="magelens.action.guard.zero">
            <action method="mark" ifconfig="0"><argument name="marker" xsi:type="string">zero</argument></action>
        </block>
        <block class="MageLens\Compatibility\Block\LayoutActionGuard" name="magelens.action.guard.same">
            <action method="mark" ifconfig="magelens_layout_fixture/actions/same_allowed"><argument name="marker" xsi:type="string">same</argument></action>
            <action method="mark" ifconfig="magelens_layout_fixture/actions/same_denied"><argument name="marker" xsi:type="string">same</argument></action>
        </block>
    </container>
    <referenceBlock name="magelens.action.guard.missing"><action method="mark" ifconfig="magelens_layout_fixture/actions/allowed"><argument name="marker" xsi:type="string">missing</argument></action></referenceBlock>
</layout>
