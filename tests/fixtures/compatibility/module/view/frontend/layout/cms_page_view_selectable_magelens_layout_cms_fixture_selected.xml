<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="magelens.layout.wireframe">
            <block class="Magento\Framework\View\Element\Template" name="magelens.layout.cms.selected" template="MageLens_Compatibility::layout-cms.phtml">
                <arguments>
                    <argument name="kind" xsi:type="string">selected</argument>
                    <argument name="value" xsi:type="string">selected-file</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
