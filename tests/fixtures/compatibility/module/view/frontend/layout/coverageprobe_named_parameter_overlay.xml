<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <block class="Magento\Framework\View\Element\Template" name="magelens.named.parameters">
        <arguments>
            <argument name="retained" xsi:type="helper" helper="MageLens\Compatibility\Model\LayoutArgumentSource::join">
                <param name="0">equal</param>
                <param name="second">retained</param>
            </argument>
            <argument name="duplicate" xsi:type="helper" helper="MageLens\Compatibility\Model\LayoutArgumentSource::join">
                <param name="first">discarded</param>
                <param name="first">winner</param>
                <param name=""/>
            </argument>
        </arguments>
        <action method="setData">
            <argument name="key" xsi:type="string">named_action</argument>
            <argument name="value" xsi:type="array">
                <item name="helper" xsi:type="helper" helper="MageLens\Compatibility\Model\LayoutArgumentSource::join">
                    <param name="left">action</param>
                    <param name="right">parameter</param>
                </item>
                <item name="number" xsi:type="number">27</item>
                <item name="text" xsi:type="string" translate="false">fixture</item>
            </argument>
        </action>
        <action method="setData" ifconfig="magelens_layout_fixture/actions/denied">
            <argument name="key" xsi:type="string">named_denied</argument>
            <argument name="value" xsi:type="helper" helper="MageLens\Compatibility\Model\LayoutArgumentSource::join">
                <param name="left">denied</param>
                <param name="right">parameter</param>
            </argument>
        </action>
    </block>
</layout>
