<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <block name="magelens.layout.grammar.configuredurl">
            <arguments>
                <argument name="value" xsi:type="configurableObject">
                    <argument name="class" xsi:type="string">MageLens\Compatibility\Model\LayoutConfiguredData</argument>
                    <argument name="data" xsi:type="array">
                        <item name="generated" xsi:type="url" path="coverageprobe/fragment/index">
                            <param name="first">alpha</param>
                            <param name="second">beta</param>
                        </item>
                    </argument>
                </argument>
            </arguments>
        </block>
    </body>
</page>
