<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <referenceBlock name="magelens.reference.subject" template="MageLens_Compatibility::layout-reference-effective.phtml">
        <arguments><argument name="marker" xsi:type="string">reference-marker</argument></arguments>
        <action method="setData">
            <argument name="key" xsi:type="string">action_marker</argument>
            <argument name="value" xsi:type="string">action-marker</argument>
        </action>
    </referenceBlock>
    <referenceContainer name="magelens.reference.inner" htmlClass="reference-effective">
        <block name="magelens.reference.attached" template="MageLens_Compatibility::layout-reference-child.phtml">
            <arguments><argument name="marker" xsi:type="string">attached-child</argument></arguments>
        </block>
    </referenceContainer>
    <referenceContainer name="magelens.reference.absent.parent">
        <block name="magelens.reference.detached" template="MageLens_Compatibility::layout-reference-child.phtml">
            <arguments><argument name="marker" xsi:type="string">detached-child</argument></arguments>
        </block>
    </referenceContainer>
    <referenceContainer name="magelens.reference.removed" remove="true"/>
    <referenceBlock name="magelens.reference.removed.child"/>
    <referenceBlock name="magelens.reference.hidden" display="false"/>
    <referenceBlock name="magelens.reference.missing" template="MageLens_Compatibility::layout-reference-effective.phtml"/>
    <referenceBlock name="magelens.reference.unrendered" template="MageLens_Compatibility::layout-reference-effective.phtml"/>
    <referenceContainer name="magelens.reference.empty" htmlClass="reference-empty"/>
</layout>
