<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/layout_generic.xsd">
    <container name="magelens.shared.action.root" output="1">
        <block class="MageLens\Compatibility\Block\LayoutShared" name="magelens.shared.action.first">
            <action method="setData">
                <argument name="key" xsi:type="string">shared_action_proof</argument>
                <argument name="value" xsi:type="string">first</argument>
            </action>
        </block>
        <block class="MageLens\Compatibility\Block\LayoutShared" name="magelens.shared.action.second">
            <action method="setData">
                <argument name="key" xsi:type="string">shared_action_proof</argument>
                <argument name="value" xsi:type="string">last</argument>
            </action>
        </block>
    </container>
</layout>
