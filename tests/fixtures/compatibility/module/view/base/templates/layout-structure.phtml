/** @var \Magento\Framework\View\Element\Template $block */
$name = str_replace('magelens.layout.', '', $block->getNameInLayout());
?>
<span data-layout-structure="<?= $block->escapeHtmlAttr($name) ?>"><?= $block->escapeHtml($name) ?></span>
<?php if ($block instanceof \MageLens\Compatibility\Block\LayoutStructure): ?>
    <span data-layout-structure-outcome><?= $block->hasExpectedStructure() ? 'verified' : 'unexpected' ?></span>
<?php endif; ?>
