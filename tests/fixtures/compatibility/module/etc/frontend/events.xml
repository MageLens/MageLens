<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="layout_generate_blocks_after">
        <observer name="magelens_layout_runtime_replacement" instance="MageLens\Compatibility\Observer\LayoutReplacement"/>
    </event>
    <event name="layout_generate_blocks_before">
        <observer name="magelens_layout_xml_mutation" instance="MageLens\Compatibility\Observer\LayoutXmlMutation"/>
    </event>
</config>
