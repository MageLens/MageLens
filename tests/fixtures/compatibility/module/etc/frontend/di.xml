<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="MageLensCompatibilityIsolatedLayout" type="Magento\Framework\View\Result\Layout">
        <arguments><argument name="isIsolated" xsi:type="boolean">true</argument></arguments>
    </virtualType>
    <virtualType name="MageLensCompatibilityIsolatedLayoutFactory" type="Magento\Framework\View\Result\LayoutFactory">
        <arguments><argument name="instanceName" xsi:type="string">MageLensCompatibilityIsolatedLayout</argument></arguments>
    </virtualType>
    <type name="MageLens\Compatibility\Controller\Dynamic\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Cachepage\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Shared\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Database\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Renderfailure\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Propertyownership\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\References\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Grammar\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="MageLens\Compatibility\Controller\Moves\Index">
        <arguments><argument name="layouts" xsi:type="object">MageLensCompatibilityIsolatedLayoutFactory</argument></arguments>
    </type>
    <type name="Magento\Framework\View\Layout\GeneratorPool">
        <plugin name="magelens_layout_move_mutation" type="MageLens\Compatibility\Model\LayoutMoveMutation"/>
    </type>
    <type name="Magento\PageCache\Model\App\FrontController\BuiltinPlugin">
        <plugin name="magelens_layout_cache_fixture" type="MageLens\Compatibility\Model\LayoutPageCache"/>
    </type>
    <type name="Magento\Framework\App\PageCache\Kernel">
        <plugin name="magelens_layout_cache_fixture" type="MageLens\Compatibility\Model\LayoutPageCache"/>
    </type>
</config>
