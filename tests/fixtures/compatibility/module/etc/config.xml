<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magelens_probe>
            <cron>
                <enabled>1</enabled>
                <unused>0</unused>
                <magerun_message>magerun-handler-ran</magerun_message>
            </cron>
        </magelens_probe>
        <magelens_layout_fixture>
            <visibility><enabled>1</enabled><disabled>0</disabled></visibility>
            <actions><allowed>1</allowed><denied>0</denied><duplicate>1</duplicate><same_allowed>1</same_allowed><same_denied>0</same_denied></actions>
        </magelens_layout_fixture>
    </default>
