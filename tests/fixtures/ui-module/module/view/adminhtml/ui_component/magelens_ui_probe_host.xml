<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magelens_ui_probe_host.probe_form_data_source</item>
        </item>
        <item name="label" xsi:type="string">MageLens UI host</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>magelens_ui_probe_host</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>magelens_ui_probe_host.probe_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="probe_form_data_source" component="Magento_Ui/js/form/provider">
        <aclResource>Magento_Backend::admin</aclResource>
        <dataProvider class="MageLens\UiProbe\Model\Provider" name="probe_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="host_fields">
        <settings>
            <label>Inserted probe form</label>
        </settings>
        <insertForm name="inserted_form">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="ns" xsi:type="string">magelens_ui_probe_form</item>
                </item>
            </argument>
            <settings>
                <autoRender>true</autoRender>
                <externalProvider>magelens_ui_probe_form.probe_form_data_source</externalProvider>
            </settings>
        </insertForm>
    </fieldset>
</form>
