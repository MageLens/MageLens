<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">magelens_ui_probe_form.probe_form_data_source</item>
        </item>
        <item name="label" xsi:type="string">MageLens probe form</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <namespace>magelens_ui_probe_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>magelens_ui_probe_form.probe_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="probe_form_data_source" component="Magento_Ui/js/form/provider">
        <aclResource>Magento_Backend::admin</aclResource>
        <dataProvider class="MageLens\UiProbe\Model\Provider" name="probe_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="probe_fields">
        <settings>
            <label>Probe fields</label>
        </settings>
        <field name="untouched" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label>Untouched field</label>
                <dataScope>untouched</dataScope>
            </settings>
        </field>
        <field name="readonly" formElement="input" sortOrder="15">
            <settings>
                <elementTmpl>ui/form/element/text</elementTmpl>
                <dataType>text</dataType>
                <label>Read-only field</label>
                <dataScope>readonly</dataScope>
            </settings>
        </field>
        <button name="invoke" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="title" xsi:type="string">Reset probe form</item>
                    <item name="displayArea" xsi:type="string">insideGroup</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">magelens_ui_probe_form.magelens_ui_probe_form</item>
                            <item name="actionName" xsi:type="string">reset</item>
                        </item>
                    </item>
                </item>
            </argument>
        </button>
        <button name="uninvoked" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="title" xsi:type="string">Unused probe action</item>
                    <item name="displayArea" xsi:type="string">insideGroup</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">magelens_ui_probe_form.magelens_ui_probe_form</item>
                            <item name="actionName" xsi:type="string">reset</item>
                        </item>
                    </item>
                </item>
            </argument>
        </button>
        <button name="uninstantiated" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="title" xsi:type="string">Uninstantiated probe action</item>
                    <item name="displayArea" xsi:type="string">insideGroup</item>
                    <item name="componentDisabled" xsi:type="boolean">true</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">magelens_ui_probe_form.magelens_ui_probe_form</item>
                            <item name="actionName" xsi:type="string">reset</item>
                        </item>
                    </item>
                </item>
            </argument>
        </button>
    </fieldset>
</form>
