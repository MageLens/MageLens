diff --git a/packages/proxy/lib/http/util/top-simulation.ts b/packages/proxy/lib/http/util/top-simulation.ts
index 36e1384..f350d27 100644
--- a/packages/proxy/lib/http/util/top-simulation.ts
+++ b/packages/proxy/lib/http/util/top-simulation.ts
@@ -1,4 +1,5 @@
 import type { HttpMiddlewareThis } from '../index'
+import { urlOriginsMatch } from '@packages/network-tools'
 
 export const doesTopNeedToBeSimulated = <T>(ctx: HttpMiddlewareThis<T>): boolean => {
   const currentAUTUrl = ctx.getAUTUrl()
@@ -8,7 +9,23 @@ export const doesTopNeedToBeSimulated = <T>(ctx: HttpMiddlewareThis<T>): boolean
     return false
   }
 
-  // only simulate top if the AUT is NOT the primary super domain origin, meaning that we should treat the AUT as top
-  // or the request is the AUT frame, which is common for redirects and navigations.
-  return !ctx.remoteStates.isPrimarySuperDomainOrigin(currentAUTUrl) || ctx.req.isAUTFrame
+  if (!ctx.remoteStates.isPrimarySuperDomainOrigin(currentAUTUrl)) {
+    return true
+  }
+
+  if (!ctx.req.isAUTFrame) {
+    return false
+  }
+
+  // A direct navigation within the primary origin already has the browser's
+  // native cookie policy. Simulating it would overwrite document.cookie changes
+  // with stale jar values, on both the request and the page-load response.
+  // Chrome's Fetch interception omits Fetch Metadata headers. Its correlated
+  // pre-request can still identify a direct navigation; redirect chains must
+  // retain simulation because they may have visited a cross-site origin.
+  const fetchSite = ctx.req.headers?.['sec-fetch-site']
+  const isDirectPrimaryNavigation = fetchSite === 'same-origin'
+    || (fetchSite === undefined && ctx.req.browserPreRequest?.hasRedirectResponse === false)
+
+  return !(isDirectPrimaryNavigation && urlOriginsMatch(currentAUTUrl, ctx.req.proxiedUrl))
 }
