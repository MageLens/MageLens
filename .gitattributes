# Source archives contain only the standalone installable project.
/tests export-ignore
/.github export-ignore
/.agents export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/AGENTS.md export-ignore
/README.md export-ignore
/CHANGELOG.md export-ignore
/LICENSE export-ignore
/LICENSE.license export-ignore
/bootstrap.sh export-ignore
/package.json export-ignore
/package.json.license export-ignore
/package-lock.json export-ignore
/package-lock.json.license export-ignore

# Preserve executable Bash entry points in Windows checkouts.
*.sh text eol=lf
*.patch text eol=lf
/compose/bin/* text eol=lf
