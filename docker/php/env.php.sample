// Magento env.php fragment for the local coverage environment.
// Installation merges these keys, preserving credentials and unrelated settings.
// The URL comes from the project's .env and is shared by the host and Cypress.
$domain = getenv('APPLICATION_DOMAIN') ?: 'magelens.test';
$port = getenv('APPLICATION_HTTPS_PORT') ?: '443';
$url = 'https://' . $domain . ($port === '443' ? '' : ':' . $port) . '/';

return [
    'MAGE_MODE' => 'developer',
    'cache_types' => [
        // Every request must execute the PHP and PHTML being measured.
        'full_page' => 0,
        'block_html' => 0,
    ],
    'system' => [
        'default' => [
            'dev' => [
                'static' => ['sign' => 0],
                'template' => ['minify_html' => 0],
                'js' => ['minify_files' => 0, 'merge_files' => 0, 'enable_js_bundling' => 0],
                'css' => ['minify_files' => 0, 'merge_css_files' => 0],
            ],
            'web' => [
                'unsecure' => ['base_url' => $url],
                'secure' => ['base_url' => $url, 'use_in_frontend' => 1, 'use_in_adminhtml' => 1],
                'url' => ['redirect_to_base' => 0],
                'cookie' => ['cookie_domain' => ''],
            ],
            // Local Admin access without production onboarding prompts.
            'twofactorauth' => ['general' => ['enable' => 0]],
            'admin' => ['usage' => ['enabled' => 0]],
        ],
    ],
];
