+  // stay native while chains that visited another origin retain simulation.
+  const fetchSite = ctx.req.headers?.['sec-fetch-site']
+  const isDirectPrimaryNavigation = fetchSite === 'same-origin'
+    || (fetchSite === undefined && ctx.req.browserPreRequest?.hasCrossOriginRedirect === false)
+
+  return !(isDirectPrimaryNavigation && urlOriginsMatch(currentAUTUrl, ctx.req.proxiedUrl))
 }
