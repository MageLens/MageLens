-  return !ctx.remoteStates.isPrimarySuperDomainOrigin(currentAUTUrl) || ctx.req.isAUTFrame
+  if (!ctx.remoteStates.isPrimarySuperDomainOrigin(currentAUTUrl)) {
+    return true
+  }
+
+  if (!ctx.req.isAUTFrame) {
+    return false
