#!/usr/bin/env bash
# SPDX-FileCopyrightText: Private Entrepreneur Vitalii Boiko
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

source "$(dirname "$0")/common"
start_services=0
refresh_cache=0
refresh_assets=0
restart_php=0
runner=${MAGELENS_RUNNER:-cypress}
for option in "$@"; do
    case "$option" in
        --start) start_services=1 ;;
        --refresh-cache) refresh_cache=1 ;;
        --refresh-assets) refresh_assets=1 ;;
        --restart-php) restart_php=1 ;;
        --runner=cypress) runner=cypress ;;
        --runner=playwright) runner=playwright ;;
        --help|-h)
            cat <<'HELP'
Usage: ./bin/run-coverage [options]

Run the selected browser suite and create fresh coverage reports using the running environment.

  --start           Start stopped application services before the run
  --refresh-cache   Clean Magento caches (for example after layout/config changes)
  --refresh-assets  Clear published static assets and Magento caches
  --restart-php     Restart PHP-FPM before the run
  --runner=cypress|playwright Assert the installed runner (defaults to saved selection)
  --help            Show this help

Source edits and theme selections are picked up automatically. Options can be combined.
HELP
            exit 0 ;;
        *) fail "Unknown option: $option. Use --help for available refresh options." ;;
    esac
done
[[ "$runner" == "${MAGELENS_RUNNER:-cypress}" ]] || fail 'This runner is not installed. Rerun ./install.sh with the required runner selection.'
preflight
[[ -f .runtime/installed ]] || fail 'Run ./install.sh first.'
[[ "$(cat .runtime/installed)" == 3 ]] || fail 'Rerun ./install.sh with your platform, theme and runner flags to update the coverage runtime and live viewer.'
lock_workflow
if (( start_services )); then
    if ! dc up -d --wait --wait-timeout 180 db redis opensearch phpfpm app runner; then
        dc logs --tail 80 db redis opensearch phpfpm app runner >&2 || true
        fail 'A required service could not start. See its logs above.'
    fi
fi
if (( restart_php )); then
    dc restart -t 60 phpfpm
    dc up -d --wait --wait-timeout 60 phpfpm
fi
dc exec -T runner true || fail 'The browser runner is stopped. Use ./bin/run-coverage --start.'
if [[ "$runner" == playwright ]]; then
    dc exec -T runner node -e "require.resolve('@vitaliiboiko/magento-template-coverage/playwright')" >/dev/null \
        || fail 'Playwright coverage requires template coverage 1.2 or newer. Update dependencies.yaml and rerun ./install.sh --playwright.'
fi
dc exec -T phpfpm php /application/docker/php/collection.php stop || fail 'Cannot prepare PHP collection. If services are stopped, use --start.'
cleanup_hooks() {
    if [[ -f .runtime/hooks-active ]]; then
        dc exec -T phpfpm php /application/docker/php/project-hooks.php cleanup || return
        rm -f .runtime/hooks-active
    fi
}
cleanup() {
    local result=$?
    trap - EXIT
    if [[ -f coverage/.active-run ]]; then
        dc exec -T phpfpm php /application/docker/php/collection.php stop || result=1
    fi
    cleanup_hooks || result=1
    rmdir "$ROOT/.runtime/workflow.lock"
    exit "$result"
}
trap cleanup EXIT
cleanup_hooks
if (( refresh_assets )); then
    dc exec -T phpfpm bash /application/docker/php/refresh-assets.sh
elif (( refresh_cache )); then
    dc exec -T phpfpm php bin/magento cache:clean
fi
say 'Preparing fresh coverage'
dc exec -T phpfpm php /application/docker/php/theme-scope.php > .runtime/active-themes.json
dc exec -T -e MAGELENS_RUNNER="$runner" runner node bin/prepare.cjs --theme-roots .runtime/active-themes.json
touch .runtime/hooks-active
dc exec -T phpfpm php /application/docker/php/project-hooks.php before
dc exec -T phpfpm php /application/docker/php/project-hooks.php prepare > coverage/project-fixtures.json
say 'Warming the storefront and fixture pages in a separate browser (up to 10 minutes)'
browser_script=bin/run-browser.cjs
[[ "$runner" == playwright ]] && browser_script=bin/run-playwright.cjs
if dc exec -T runner timeout --signal=TERM --kill-after=10s 600s node "$browser_script" --warmup; then
    say 'Browser warm-up completed; starting fresh coverage collection'
else
    result=$?
    if [[ "$result" == 124 || "$result" == 137 ]]; then
        printf 'Browser warm-up exceeded its 10-minute limit.\n' >&2
    fi
    printf 'Warm-up failed. Inspect coverage/warmup-results.json, coverage/warmup-diagnostics.json and coverage/warmup-screenshots/.\n' >&2
    exit "$result"
fi
dc exec -T phpfpm php /application/docker/php/manifest.php
dc exec -T phpfpm php /application/docker/php/collection.php start
say "Running the full $runner suite (preparation: ${SECONDS}s)"
dc exec -T runner node "$browser_script"
say 'Generating coverage reports'
dc exec -T phpfpm php /application/docker/php/report.php
dc exec -T runner sh -c 'node bin/report-browser.cjs && node bin/finalize.cjs'
say 'Open coverage/index.html for the combined report'
