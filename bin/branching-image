#!/usr/bin/env bash
# SPDX-FileCopyrightText: Private Entrepreneur Vitalii Boiko
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

set -euo pipefail
cd "$(dirname "$0")/.."
root=$(pwd -P)
source bin/dependencies
load_dependencies "$root/dependencies.yaml"
kind=${1:-}
[[ -n "$kind" ]] || { echo "Usage: bin/branching-image KIND [--build-from-source]" >&2; exit 1; }
shift
mode=${MAGELENS_BRANCHING_BUILD_FROM_SOURCE:-0}
if [[ ${1:-} == --build-from-source && $# == 1 ]]; then mode=1
elif [[ $# != 0 ]]; then echo 'Usage: bin/branching-image KIND [--build-from-source]' >&2; exit 1; fi
[[ "$mode" == 0 || "$mode" == 1 ]] || { echo 'MAGELENS_BRANCHING_BUILD_FROM_SOURCE must be 0 or 1.' >&2; exit 1; }
[[ "$root" != *','* ]] || { echo 'Checkout paths cannot contain commas.' >&2; exit 1; }
platform=$(docker info --format '{{.OSType}}/{{.Architecture}}')
case "$platform" in
    linux/amd64|linux/x86_64) architecture=amd64 ;;
    linux/arm64|linux/aarch64) architecture=arm64 ;;
    *) echo 'The orchestrator needs Linux Docker containers.' >&2; exit 1 ;;
esac
metadata=$(docker run --rm --network none --user "$(id -u):$(id -g)" \
    --mount "type=bind,source=$root,target=/workspace,readonly" --workdir /workspace \
    --entrypoint node "$PLAYWRIGHT_RUNNER_IMAGE" branching/images.cjs describe "$kind")
IFS=$'\t' read -r fingerprint package context <<< "$metadata"
[[ "$fingerprint" =~ ^[a-f0-9]{64}$ ]] || { echo 'Invalid orchestrator input fingerprint.' >&2; exit 1; }
image="magelens-$package:inputs-$fingerprint-$architecture"
verify() {
    local actual
    actual=$(docker image inspect --format '{{.Os}}/{{.Architecture}} {{index .Config.Labels "org.magelens.inputs"}}' "$1")
    [[ "$actual" == "linux/$architecture $fingerprint" ]] || { echo 'Orchestrator image does not match this source and architecture.' >&2; exit 1; }
}
if [[ "$mode" == 0 ]]; then
    if docker image inspect "$image" >/dev/null 2>&1; then verify "$image"; printf '%s\n' "$image"; exit 0; fi
    if [[ "$architecture" == amd64 ]]; then
        remote="ghcr.io/magelens/$package:inputs-$fingerprint"
        if docker pull "$remote" >&2; then
            verify "$remote"; docker tag "$remote" "$image"; printf '%s\n' "$image"; exit 0
        fi
        echo 'No matching prebuilt branching image is available yet. Wait for the image-builder CI, or explicitly use MAGELENS_BRANCHING_BUILD_FROM_SOURCE=1 for development.' >&2
    else
        echo 'Prebuilt branching images currently support linux/amd64. Other platforms require an explicit development build and are not qualified yet.' >&2
    fi
    exit 1
fi
build_args=()
if [[ "$kind" != orchestrator ]]; then
    base=$(docker run --rm --user "$(id -u):$(id -g)" --mount "type=bind,source=$root,target=/workspace,readonly" --workdir /workspace --entrypoint node "$PLAYWRIGHT_RUNNER_IMAGE" branching/images.cjs base "$kind")
    build_args=(--build-arg "RUNNER_IMAGE=$base")
fi
docker build --quiet --tag "$image" --label "org.magelens.inputs=$fingerprint" \
    --label 'org.opencontainers.image.source=https://github.com/MageLens/MageLens' "${build_args[@]}" "$context" >/dev/null
verify "$image"
printf '%s\n' "$image"
