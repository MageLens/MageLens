set -euo pipefail
cd "$(dirname "$0")/.."
source branching/configs/entrypoints.conf
if [[ ${1:-} == --help ]]; then
    printf 'Usage: ./bin/plan-branching [--evaluate] SOURCE_ROOT [MANIFEST.json]\nDefault manifest: %s (override with MAGELENS_BRANCHING_MANIFEST).\n' "$BRANCHING_DEFAULT_MANIFEST"
    exit 0
fi
operation=plan
if [[ ${1:-} == --evaluate ]]; then operation=evaluate; shift; fi
[[ $# -ge 1 && $# -le 2 ]] || { echo 'Expected [--evaluate] SOURCE_ROOT [MANIFEST.json]' >&2; exit 1; }
root=$(pwd -P)
source_root=$(realpath -e "$1")
[[ "$source_root" == "$root/"* || "$source_root" == "$root" ]] || { echo 'Source must be within this checkout' >&2; exit 1; }
manifest=${2-${MAGELENS_BRANCHING_MANIFEST:-$BRANCHING_DEFAULT_MANIFEST}}
mkdir -p "$(dirname "$manifest")"
manifest=$(realpath -m "$manifest")
[[ "$manifest" == "$root/"* && "$root" != *','* ]] || { echo 'Manifest must be in this checkout; paths cannot contain commas' >&2; exit 1; }
planner_image=$(./bin/branching-image orchestrator)
docker run --rm --init --memory 1g --memory-swap 1g --user "$(id -u):$(id -g)" \
    --mount "type=bind,source=$root,target=$root" --workdir "$root" \
    "$planner_image" "$operation" "$source_root" "$manifest"
printf 'Manifest: %s\n' "$manifest"
