#!/usr/bin/env bash
# SPDX-FileCopyrightText: Private Entrepreneur Vitalii Boiko
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

source "$(dirname "$0")/common"
[[ "${1:-}" == --branching || "${1:-}" == --help ]] || fail 'Checkpoint execution requires --branching. Use bin/run-coverage for the normal linear run.'
[[ "${1:-}" != --branching ]] || shift
if [[ "${1:-}" == --help ]]; then
    printf 'Usage: ./bin/run-coverage --branching --disposable [--calibrate] MANIFEST.json CONFIG.cjs COW_STORAGE\nAUTO is the only checkpoint policy. The optional --auto spelling is also accepted.\n--calibrate refreshes project checkpoint costs without executing tests.\nSuccessful runs update the baseline by default; set baseline.updateOnSuccess=false to opt out.\nConfigure test selection in the native runner configuration.\nBranching produces execution reports; coverage collection is not supported yet.\n'
    exit 0
fi
[[ "${1:-}" == --disposable ]] || fail 'Use --disposable MANIFEST.json CONFIG.cjs COW_STORAGE.'
[[ "$MAGELENS_RUNNER" == playwright ]] || fail "Branching for $MAGELENS_RUNNER is not implemented yet. Use the normal linear run without --branching."
shift
calibrate=0
if [[ "${1:-}" == --calibrate ]]; then calibrate=1; shift; fi
[[ "${1:-}" != --auto ]] || shift
[[ $# -eq 3 || ( $# -eq 4 && "${4:-}" == AUTO ) ]] || fail 'AUTO is the only checkpoint policy. Use MANIFEST.json CONFIG.cjs COW_STORAGE; configure test selection in the native runner.'
manifest=$(realpath -e "$1")
configuration=$(realpath -e "$2")
storage=$(realpath -e "$3")
[[ "$manifest" == "$ROOT/"* && "$configuration" == "$ROOT/"* && -f "$manifest" && -f "$configuration" ]] || fail 'Manifest and configuration must be files in this checkout.'
[[ -f .runtime/installed ]] || fail 'Install a dedicated test checkout first.'
[[ ! -e .runtime/workflow.lock && ! -e .runtime/branching-recovery.json ]] || fail 'An active or interrupted workflow needs recovery first.'
preflight
[[ "$(docker info --format '{{.OSType}}')" == linux ]] || fail 'branching currently supports native Linux Docker only.'
entrypoint=node
driver_command=(branching/auto-cli.cjs "$manifest" "$configuration" "$storage")
if (( calibrate )); then driver_command=(branching/calibration-cli.cjs "$manifest" "$configuration" "$storage"); fi
[[ -d "$storage" && "$storage" != *','* && "$ROOT" != *','* ]] || fail 'Use an existing CoW directory; bind mount paths cannot contain commas.'
runner=$(dc ps -q runner)
[[ -n "$runner" ]] || fail 'Start this installation with bin/start first.'
network=$(docker inspect --format '{{range $name, $value := .NetworkSettings.Networks}}{{$name}}{{end}}' "$runner")
image=$("$ROOT/bin/branching-image" "$MAGELENS_RUNNER")
planner_image=$("$ROOT/bin/branching-image" orchestrator)
modules=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/workspace/node_modules"}}type={{.Type}},source={{if eq .Type "volume"}}{{.Name}}{{else}}{{.Source}}{{end}},target=/workspace/node_modules,readonly{{end}}{{end}}' "$runner")
[[ -n "$modules" ]] || fail 'The installed runner has no dependency mount.'
controller=$(docker run --detach --rm --init --network none --memory 512m --memory-swap 512m \
    --user "$LOCAL_UID:$LOCAL_GID" --mount "type=bind,source=$ROOT,target=$ROOT,readonly" --workdir "$ROOT" \
    --label org.magelens.role=branching-orchestrator --entrypoint sleep "$planner_image" infinity)
cleanup_controller() { local result=$?; trap - EXIT; docker rm --force "$controller" >/dev/null || result=1; exit "$result"; }
trap cleanup_controller EXIT
docker exec "$controller" magelens-plan verify "$manifest"
# Driver needs Docker control for the application barrier. No ports are exposed.
# The original browser runner and normal coverage entry point remain unchanged.
docker run --rm --init --memory 2g --memory-swap 2g --shm-size 512m \
    --network "$network" --mount type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock \
    --mount "$modules" \
    --mount "type=bind,source=$ROOT,target=$ROOT" --mount "type=bind,source=$storage,target=$storage" \
    --workdir "$ROOT" --env "MAGELENS_BRANCHING_IMAGE=$image" \
    --env MAGELENS_RUNNER --env "MAGELENS_ORCHESTRATOR_CONTAINER=$controller" \
    --env "MAGELENS_HOST_UID=$LOCAL_UID" --env "MAGELENS_HOST_GID=$LOCAL_GID" \
    --env "LOCAL_UID=$LOCAL_UID" --env "LOCAL_GID=$LOCAL_GID" \
    --env PLAYWRIGHT_VERSION --env CHROME_VERSION \
    --env "PLAYWRIGHT_BASE_URL=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$runner" | sed -n 's/^PLAYWRIGHT_BASE_URL=//p')" \
    --entrypoint "$entrypoint" "$image" "${driver_command[@]}"
