source "$(dirname "$0")/common"
bootstrap_image=$1
build_from_source=$2
missing_image_error_pattern='manifest unknown|manifest for .* not found|@sha256:[a-f0-9]{64}[^[:space:]]*: not found'
authorization_error_pattern='unauthorized|denied|forbidden|authentication required|(^|[^[:alnum:]])(401|403)([^[:alnum:]]|$)'
resolve_images() {
    docker run --rm --pull never --user "$LOCAL_UID:$LOCAL_GID" \
        --mount "type=bind,source=$ROOT,target=/workspace" --workdir /workspace \
        --env MAGELENS_RUNNER \
        --env "MAGELENS_IMAGE_PLATFORM=$architecture" \
        --entrypoint node "$bootstrap_image" bin/image-inputs.cjs "$1"
}
# Never let a previous installation's override redirect a new source build.
rm -f .runtime/compose.images.yaml .runtime/prebuilt-images.json
if [[ "$build_from_source" == 0 ]]; then
    architecture=$(docker info --format '{{.OSType}}/{{.Architecture}}')
    case "$architecture" in
        linux/x86_64|linux/amd64) architecture=linux/amd64 ;;
        linux/aarch64|linux/arm64) architecture=linux/arm64 ;;
    esac
    resolve_images resolve
else
    printf '{}\n' > .runtime/prebuilt-images.json
fi
# Read validated data through Node, never source downloaded shell code.
selected() {
    docker run --rm --pull never --mount "type=bind,source=$ROOT/.runtime/prebuilt-images.json,target=/images.json,readonly" \
        --entrypoint node "$bootstrap_image" -e 'console.log(require("/images.json")[process.argv[1]]?.[process.argv[2]] || "")' "$1" "$2"
}
php_image=$(selected php image)
runner_image=$(selected "runner-$MAGELENS_RUNNER" image)
# Keep only the final pull attempt's diagnostic when classifying a failure.
pull_image() { docker pull "$1" 2> "$pull_error_file"; }
for kind in php "runner-$MAGELENS_RUNNER"; do
    image=$(selected "$kind" image)
    [[ -n "$image" ]] || continue
    say "Pulling qualified $kind image $image"
    pull_error_file=$(mktemp "$ROOT/.runtime/image-pull.XXXXXX")
    if download_with_retry pull_image "$image"; then
        cat "$pull_error_file" >&2
        rm -f "$pull_error_file"
    else
        pull_status=$?
        pull_error=$(cat "$pull_error_file")
        rm -f "$pull_error_file"
        printf '%s\n' "$pull_error" >&2
        [[ "$pull_status" != 130 && "$pull_status" != 143 ]] || exit "$pull_status"
        # A registry failure alone never permits a source fallback. Re-fetch the
        # canonical manifest and require intentional expiration of this release.
        pull_error_lower=$(printf '%s' "$pull_error" | tr '[:upper:]' '[:lower:]')
        if [[ "$pull_error_lower" =~ $missing_image_error_pattern && ! "$pull_error_lower" =~ $authorization_error_pattern ]]; then
            resolve_images confirm-expiration
            php_image='' runner_image=''
            break
        fi
        exit "$pull_status"
    fi
    actual=$(docker image inspect --format '{{index .Config.Labels "org.magelens.inputs"}}' "$image")
    [[ "$actual" == "$(selected "$kind" inputs)" ]] || fail "The $kind image has incorrect build provenance."
done
if [[ -n "$runner_image" && "$MAGELENS_RUNNER" == cypress ]]; then
    docker run --rm --entrypoint node \
        --mount "type=bind,source=$ROOT/docker/runner/cypress-source,target=/expected,readonly" \
        "$runner_image" -e 'require("/expected/provenance.cjs").verifyInstalled()'
fi
if [[ -n "$php_image" ]]; then
    # Only account ownership is local; no PHP extensions or Composer packages rebuild.
    cat > .runtime/compose.images.yaml <<YAML
services:
  phpfpm: &portable-php
    image: \${COMPOSE_PROJECT_NAME}-php:local
    build:
      dockerfile: docker/php/uid.Dockerfile
      args:
        PHP_IMAGE: $php_image
  workspace: *portable-php
YAML
else
    say 'No compatible prebuilt PHP image selected; building PHP/PCOV from source.'
    "$ROOT/bin/build-php-image"
fi
dc build phpfpm
if [[ -n "$runner_image" ]]; then
    [[ -f .runtime/compose.images.yaml ]] || printf 'services:\n' > .runtime/compose.images.yaml
    cat >> .runtime/compose.images.yaml <<YAML
  runner:
    build: !reset null
    image: $runner_image
YAML
else
    say "No compatible prebuilt $MAGELENS_RUNNER image selected; building from source."
    dc build --pull runner
fi
