#!/usr/bin/env bash
# Copyright (c)  MageLens
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

source "$(dirname "$0")/common"
series=${PHP_VERSION%.*}
context="$ROOT/.runtime/docker-magento/images/php/$series"
recipe="$context/Dockerfile"
# Keep all of the pinned upstream recipe's extensions, tools, and FPM settings.
# Reject an incompatible recipe rather than silently using its unpatched base.
expected="FROM php:$series-fpm-bookworm AS base"
[[ -f "$recipe" ]] && [[ $(grep -cFx "$expected" "$recipe") == 1 ]] \
    || fail "The selected Mark Shust release has no compatible PHP $series Bookworm base recipe."
mkdir -p "$ROOT/.runtime"
generated="$ROOT/.runtime/php-base.Dockerfile"
# Install the same probe from Blackfire's versioned Debian packages. The
# release API can return an HTML gateway error instead of a probe archive.
# read, not $(cat ...): bash 3.2 (macOS /bin/bash) misparses the case patterns in a
# here-document inside a command substitution. read returns 1 at the end of input.
IFS= read -r -d '' blackfireInstall <<'DOCKERFILE' || true
RUN set -eu; \
    arch=$(dpkg --print-architecture); \
    case "$arch" in \
        amd64) sha=@BLACKFIRE_AMD64_SHA256@ ;; \
        arm64) sha=@BLACKFIRE_ARM64_SHA256@ ;; \
        *) exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --connect-timeout 20 --max-time 180 \
        "https://packages.blackfire.io/debian/pool/any/main/b/blackfire-php/blackfire-php_@BLACKFIRE_VERSION@_${arch}.deb" -o /tmp/blackfire.deb; \
    echo "$sha  /tmp/blackfire.deb" | sha256sum -c -; \
    dpkg-deb -x /tmp/blackfire.deb /tmp/blackfire; \
    extensions=$(php-config --extension-dir); \
    install -m 0644 "/tmp/blackfire/usr/lib/blackfire-php/$arch/blackfire-${extensions##*-}.so" "$extensions/blackfire.so"; \
    php -d extension=blackfire.so --ri blackfire >/dev/null; \
    rm -rf /tmp/blackfire /tmp/blackfire.deb
DOCKERFILE
[[ -n $blackfireInstall ]] || fail 'Could not read the Blackfire installation step.'
blackfireInstall=${blackfireInstall%$'\n'}
for pin in BLACKFIRE_VERSION BLACKFIRE_AMD64_SHA256 BLACKFIRE_ARM64_SHA256; do
    blackfireInstall=${blackfireInstall//@$pin@/${!pin}}
done
export blackfireInstall
awk -v expected="$expected" -v image="$PHP_IMAGE" -v composer="$COMPOSER_VERSION" \
    '
    $0 == expected { print "FROM " image " AS base"; next }
    /^RUN version=.*PHP_MAJOR_VERSION.PHP_MINOR_VERSION/ { probe = 1 }
    probe {
        if (/blackfire.io\/api\/v1\/releases\/probe/) probeUrl = 1
        if ($0 !~ /\\$/) {
            if (!probeUrl || $0 !~ /rm -rf \/tmp\/blackfire \/tmp\/blackfire-probe.tar.gz$/) exit 1
            print ENVIRON["blackfireInstall"]; probe = probeUrl = 0
        }
        next
    }
    /--version=[0-9]+\.[0-9]+\.[0-9]+ --install-dir=\/usr\/local\/bin --filename=composer$/ {
        sub(/--version=[0-9]+\.[0-9]+\.[0-9]+/, "--version=" composer)
        composerInstallations++
    }
    /^COPY conf\/[[:alnum:].-]+\.(ini|conf) / {
        # A restrictive host umask can make checked-out settings root-only.
        sub(/^COPY /, "COPY --chmod=0644 ")
    }
    /^RUN pecl channel-update pecl.php.net && pecl install \\$/ {
        # PECL can return success for a batch when one package was not installed.
        # Check each pinned extension in the same layer, before it can be cached.
        print "RUN pecl channel-update pecl.php.net \\"; extensions = 1; next
    }
    extensions && /^    [a-zA-Z0-9_]+-[0-9][^[:space:]]* \\$/ {
        name = $1; sub(/-[0-9].*$/, "", name)
        print "  && pecl install " $1 " \\"
        print "  && test -s \"$(php-config --extension-dir)/" name ".so\" \\"
        next
    }
    extensions && /^  && pecl clear-cache/ { extensions = 0 }
    extensions { print "Unsupported upstream PECL installation recipe" > "/dev/stderr"; exit 1 }
    { print }
    END {
        if (extensions || probe) exit 1
        if (composerInstallations != 1) {
            print "Unsupported upstream Composer installation recipe" > "/dev/stderr"
            exit 1
        }
    }
    ' "$recipe" > "$generated"
say "Rebuilding Mark Shust PHP $series with official PHP $PHP_VERSION"
docker build --pull --target base --file "$generated" \
    --tag "$APPLICATION_PHP_IMAGE" "$context"
