<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Application\Blog\Model\JournalAreaPreference" type="Application\Blog\Model\JournalFrontendPreference"/>
    <virtualType name="Application\Blog\Model\JournalArgumentAlias" type="Application\Blog\Model\JournalArgumentProbe">
        <arguments><argument name="label" xsi:type="string">GraphQL label</argument></arguments>
