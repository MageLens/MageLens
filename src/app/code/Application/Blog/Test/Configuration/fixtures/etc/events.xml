<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="magelens_journal_observers">
        <observer name="global_journal"
                  instance="Application\Blog\Observer\JournalProbe"/>
        <observer name="disabled_in_frontend" instance="Application\Blog\Observer\JournalProbe"/>
        <observer name="external_override" instance="Application\Blog\Observer\JournalProbe"/>
    </event>
    <event name="magelens_journal_unvisited">
        <observer name="unvisited" instance="Application\Blog\Observer\JournalProbe"/>
    </event>
    <event name="magelens_journal_warmup">
        <observer name="warmup" instance="Application\Blog\Observer\JournalProbe"/>
    </event>
</config>
