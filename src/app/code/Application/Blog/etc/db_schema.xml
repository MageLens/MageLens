<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="application_blog_category" resource="default" engine="innodb" comment="Blog Categories">
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" identity="true" comment="Category ID"/>
        <column xsi:type="varchar" name="name" length="120" nullable="false" comment="Name"/>
        <column xsi:type="varchar" name="slug" length="120" nullable="false" comment="URL Slug"/>
        <column xsi:type="smallint" name="is_active" nullable="false" default="1" comment="Enabled"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="category_id"/></constraint>
        <constraint xsi:type="unique" referenceId="APPLICATION_BLOG_CATEGORY_SLUG"><column name="slug"/></constraint>
    </table>
    <table name="application_blog_post" resource="default" engine="innodb" comment="Blog Posts">
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" identity="true" comment="Post ID"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="false" comment="Category ID"/>
        <column xsi:type="varchar" name="title" length="200" nullable="false" comment="Title"/>
        <column xsi:type="varchar" name="slug" length="160" nullable="false" comment="URL Slug"/>
        <column xsi:type="varchar" name="author" length="120" nullable="false" comment="Author"/>
        <column xsi:type="text" name="excerpt" nullable="false" comment="Excerpt"/>
        <column xsi:type="mediumtext" name="body" nullable="false" comment="Body"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="draft" comment="Publication Status"/>
        <column xsi:type="datetime" name="published_at" nullable="true" comment="Publication Time UTC"/>
        <column xsi:type="varchar" name="image" length="255" nullable="true" comment="Featured Image"/>
        <column xsi:type="varchar" name="meta_title" length="200" nullable="false" default="" comment="Meta Title"/>
        <column xsi:type="varchar" name="meta_description" length="300" nullable="false" default="" comment="Meta Description"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="post_id"/></constraint>
        <constraint xsi:type="unique" referenceId="APPLICATION_BLOG_POST_SLUG"><column name="slug"/></constraint>
        <constraint xsi:type="foreign" referenceId="APPLICATION_BLOG_POST_CATEGORY" table="application_blog_post" column="category_id" referenceTable="application_blog_category" referenceColumn="category_id" onDelete="NO ACTION"/>
        <index referenceId="APPLICATION_BLOG_POST_PUBLICATION" indexType="btree"><column name="status"/><column name="published_at"/></index>
    </table>
    <table name="application_blog_comment" resource="default" engine="innodb" comment="Moderated Blog Comments">
        <column xsi:type="int" name="comment_id" unsigned="true" nullable="false" identity="true" comment="Comment ID"/>
        <column xsi:type="int" name="post_id" unsigned="true" nullable="false" comment="Post ID"/>
        <column xsi:type="varchar" name="name" length="120" nullable="false" comment="Reader Name"/>
        <column xsi:type="varchar" name="email" length="254" nullable="false" comment="Private Reader Email"/>
        <column xsi:type="text" name="body" nullable="false" comment="Comment"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="pending" comment="Moderation Status"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="comment_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="APPLICATION_BLOG_COMMENT_POST" table="application_blog_comment" column="post_id" referenceTable="application_blog_post" referenceColumn="post_id" onDelete="CASCADE"/>
        <index referenceId="APPLICATION_BLOG_COMMENT_STATUS" indexType="btree"><column name="post_id"/><column name="status"/></index>
    </table>
</schema>
