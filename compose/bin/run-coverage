#!/usr/bin/env bash
# Copyright (c)  MageLens
# SPDX-License-Identifier: Elastic-2.0
# License: see LICENSE in the repository root.

source "$(dirname "$0")/common"
start_services=0
refresh_cache=0
refresh_assets=0
restart_php=0
readme_options=()
report_options=()
runner=${MAGELENS_RUNNER:-cypress}
for option in "$@"; do
    case "$option" in
        --start) start_services=1 ;;
        --refresh-cache) refresh_cache=1 ;;
        --refresh-assets) refresh_assets=1 ;;
        --restart-php) restart_php=1 ;;
        --update-readme) readme_options=(--update-readme) ;;
        --include-machine-report) report_options=(--include-machine-report) ;;
        --runner=cypress) runner=cypress ;;
        --runner=playwright) runner=playwright ;;
        --help|-h)
            cat <<'HELP'
Usage: ./bin/run-coverage [options]

Run the selected browser suite and shared CLI tests, then create fresh coverage reports using the running environment.

  --start           Start stopped application services before the run
  --refresh-cache   Clean Magento caches (for example after layout/config changes)
  --refresh-assets  Clear published static assets and Magento caches
  --restart-php     Restart PHP-FPM before the run
  --update-readme   Mark README badges pending, then update them after the reports are validated
  --include-machine-report Also write the SQLite coverage database (coverage/report.sqlite)
  --runner=cypress|playwright Assert the installed runner (defaults to saved selection)
  --help            Show this help

Source edits and theme selections are picked up automatically. Options can be combined.
HELP
            exit 0 ;;
        *) fail "Unknown option: $option. Use --help for available refresh options." ;;
    esac
done
[[ "$runner" == "${MAGELENS_RUNNER:-cypress}" ]] || fail 'This runner is not installed. Rerun ./install.sh with the required runner selection.'
preflight
[[ -f .runtime/installed ]] || fail 'Run ./install.sh first.'
installed_runtime=$(cat .runtime/installed)
[[ "$installed_runtime" == 6 ]] \
    || fail 'Rerun ./install.sh with your saved platform, theme and runner flags to install the current browser runner and PHP coverage hooks.'
lock_workflow
report_link=src/pub/media/coverage
report_target=../../../coverage/.site
if [[ -L "$report_link" ]]; then
    case "$(readlink "$report_link")" in
        "$report_target"|../../../coverage) rm "$report_link" ;;
    esac
fi
if [[ -e "$report_link" || -L "$report_link" ]]; then
    fail "Cannot publish coverage: $report_link already exists and is not the MageLens report symlink. Move it aside first."
fi
if (( start_services )); then
    if ! dc up -d --wait --wait-timeout 180 db redis opensearch phpfpm app runner; then
        dc logs --tail 80 db redis opensearch phpfpm app runner >&2 || true
        fail 'A required service could not start. See its logs above.'
    fi
fi
if (( restart_php )); then
    dc restart -t 60 phpfpm
    dc up -d --wait --wait-timeout 60 phpfpm
fi
dc exec -T runner true || fail 'Cannot access the browser runner. Check the diagnostics above; if services are stopped, use ./bin/run-coverage --start.'
if [[ "$runner" == playwright ]]; then
    dc exec -T runner node -e "require.resolve('@magelens/magento-template-coverage/playwright')" >/dev/null \
        || fail 'Playwright coverage requires template coverage 1.2 or newer. Update dependencies.yaml and rerun ./install.sh --playwright.'
fi
dc exec -T phpfpm php /application/docker/php/collection.php stop || fail 'Cannot prepare PHP collection. If services are stopped, use --start.'
cleanup_hooks() {
    if [[ -f .runtime/hooks-active ]]; then
        dc exec -T phpfpm php /application/docker/php/project-hooks.php cleanup || return 1
        rm -f .runtime/hooks-active
    fi
}
report_ready=0
report_url=''
publish_report() {
    report_url=$(dc exec -T phpfpm php /application/docker/php/report-url.php) || return 1
    [[ "$report_url" == http://* || "$report_url" == https://* ]] || return 1
    dc exec -T runner node bin/public-report.cjs || return 1
    dc exec -T app test -r /var/www/coverage/.site/index.html || return 1
    ln -s "$report_target" "$report_link"
}
cleanup() {
    local result=$?
    trap - EXIT
    if [[ -f coverage/.active-run ]]; then
        dc exec -T phpfpm php /application/docker/php/collection.php stop || result=1
    fi
    cleanup_hooks || result=1
    if (( result == 0 && report_ready )); then
        publish_report || { printf 'Cannot publish the coverage report through pub/media. Local reports remain in coverage/.\n' >&2; result=1; }
    fi
    rmdir "$ROOT/.runtime/workflow.lock" || result=1
    local published=0
    if (( result == 0 && report_ready )); then
        printf '\nOpen the combined coverage report: %s\n' "$report_url"
        published=1
    elif [[ -L "$report_link" && "$(readlink "$report_link")" == "$report_target" ]]; then
        rm -f "$report_link"
    fi
    if [[ -n "$failed_suites" ]]; then
        if (( published )); then
            printf '\nTests failed in the %s. The reports include their results.\n' "$failed_suites" >&2
        else
            printf '\nTests failed in the %s. No report was published.\n' "$failed_suites" >&2
        fi
        (( result )) || result=1
    fi
    exit "$result"
}
failed_suites=''
record_failure() {
    [[ "$1" != 130 && "$1" != 143 ]] || exit "$1"
    failed_suites+="${failed_suites:+ and the }$2"
}
trap cleanup EXIT
# An interrupted run publishes nothing, even when a suite exits normally after the signal.
trap 'exit 130' INT
cleanup_hooks
# Older running containers need the new report mount and static location.
dc exec -T app sh -c 'test -d /var/www/coverage && grep -q "location ^~ /media/coverage/" /etc/nginx/conf.d/default.conf' \
    || fail 'Rerun ./install.sh with your saved platform, theme and runner flags to enable report publication.'
mkdir -p src/pub/media
if (( refresh_cache && !refresh_assets )); then
    dc exec -T phpfpm php bin/magento cache:clean
fi
say 'Preparing fresh coverage'
dc exec -T phpfpm php /application/docker/php/theme-scope.php > .runtime/active-themes.json
dc exec -T -e MAGELENS_RUNNER="$runner" runner node bin/prepare.cjs --theme-roots .runtime/active-themes.json ${readme_options[@]+"${readme_options[@]}"}
if (( refresh_assets )); then
    dc exec -T phpfpm bash /application/docker/php/refresh-assets.sh
fi
touch .runtime/hooks-active
dc exec -T phpfpm php /application/docker/php/project-hooks.php before
dc exec -T phpfpm php /application/docker/php/project-hooks.php prepare > coverage/project-fixtures.json
dc exec -T phpfpm php /application/docker/php/xml-manifest.php
say 'Warming the storefront and fixture pages in a separate browser (up to 10 minutes)'
browser_script=bin/run-browser.cjs
[[ "$runner" == playwright ]] && browser_script=bin/run-playwright.cjs
if dc exec -T runner timeout --signal=TERM --kill-after=10s 600s node "$browser_script" --warmup; then
    say 'Browser warm-up completed; starting fresh coverage collection'
else
    result=$?
    if [[ "$result" == 124 || "$result" == 137 ]]; then
        printf 'Browser warm-up exceeded its 10-minute limit.\n' >&2
    fi
    printf 'Warm-up failed. Inspect coverage/warmup-results.json, coverage/warmup-diagnostics.json and coverage/warmup-screenshots/.\n' >&2
    exit "$result"
fi
dc exec -T phpfpm php /application/docker/php/manifest.php
dc exec -T phpfpm php /application/docker/php/collection.php start
say "Running the full $runner suite (preparation: ${SECONDS}s)"
# A failed suite does not stop the remaining tests or the reports; the run still exits non-zero.
browser_status=0
dc exec -T runner node "$browser_script" || browser_status=$?
(( browser_status == 0 )) || record_failure "$browser_status" "$runner suite"
say 'Running shared Magento CLI tests'
cli_status=0
"$ROOT/bin/cli-relay" || cli_status=$?
(( cli_status == 0 )) || record_failure "$cli_status" 'CLI suite'
# Finalization checks each suite's published test outcome against its exit status.
run_id=$(dc exec -T runner node -p "require('./coverage/run.json').id") || run_id=''
[[ "$run_id" =~ ^[0-9a-f]{32}$ ]] || fail 'Cannot read the current run ID from coverage/run.json.'
printf '{"run":"%s","%s":%d,"cli":%d}\n' "$run_id" "$runner" "$browser_status" "$cli_status" > coverage/suite-status.json
say 'Generating coverage reports'
dc exec -T phpfpm php /application/docker/php/report.php
dc exec -T phpfpm php /application/docker/php/xml-manifest.php check
dc exec -T runner sh -c 'node bin/report-browser.cjs && node bin/report-xml.cjs && node bin/report-attribution.cjs && node bin/finalize.cjs "$@"' sh ${readme_options[@]+"${readme_options[@]}"} ${report_options[@]+"${report_options[@]}"}
report_ready=1
