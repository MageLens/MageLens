{
  "name": "magelens",
  "version": "1.11.0",
  "private": true,
  "license": "Elastic-2.0",
  "description": "Run Magento tests with PHP, JavaScript, HTML/PHTML template and XML configuration coverage",
  "scripts": {
    "coverage": "./bin/run-coverage",
    "cy:coverage": "./bin/run-coverage"
  },
  "devDependencies": {
    "@cypress/code-coverage": "4.1.3",
    "@magelens/magento-template-coverage": "2.1.4",
    "cypress": "16.4.0",
    "html-validate": "11.21.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "mustache": "4.2.0",
    "nyc": "18.0.0"
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.4",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  },
  "nyc": {
    "include": [
      "src/app/code/**/*.js",
      "src/app/design/frontend/**/*.js",
      "src/app/design/adminhtml/**/*.js"
    ],
    "exclude": [
      "**/*.cy.js",
      "**/Test/**",
      "**/Setup/**",
      "**/cypress/**"
    ],
    "report-dir": "coverage/js",
    "reporter": [
      "html",
      "json",
      "json-summary",
      "text-summary"
    ],
    "instrument": false,
    "sourceMap": false
  }
}
